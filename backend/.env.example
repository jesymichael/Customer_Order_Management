# Supabase project settings (Dashboard > Settings > API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# COM-13 asks for 24h token expiry — set this in Supabase:
#   Dashboard > Authentication > Sessions > Access token expiry = 86400
# Also disable email confirmation so register issues a JWT immediately:
#   Dashboard > Authentication > Providers > Email > Confirm email = off

JWT_AUDIENCE=authenticated
CORS_ORIGINS=http://localhost:3000

# Product seeding (CI) shared secret, and comma-separated emails granted
# access to the admin management screens (Users, Manage products).
ADMIN_SECRET=change-me
ADMIN_EMAILS=you@example.com
